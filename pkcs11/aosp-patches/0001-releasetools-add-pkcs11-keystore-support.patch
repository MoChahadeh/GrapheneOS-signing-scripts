From: GrapheneOS YubiKey signing
Subject: [PATCH] releasetools: add PKCS#11 keystore support for signapk

Adds a `--use_pkcs11_aliases` flag and an `OTATOOLS_PKCS11_ALIAS_MAP`
environment variable so that `common.SignFile()` can hand signapk.jar a
keystore alias (the CKA_LABEL on a PKCS#11 token) in place of the usual
`.pk8` filename. signapk.jar already speaks PKCS#11 natively when invoked
with `-providerClass`, `-providerArg`, and `-loadPrivateKeysFromKeyStore`;
those are supplied through the existing `--extra_signapk_args` plumbing.

Also stops GetKeyPasswords() from probing (now-nonexistent) .pk8 files
when the keystore is in use.

Apply against platform_build (build/make/ in the AOSP source tree).

diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index 1ea01d7..93d5ebb 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -81,6 +81,21 @@ class Options(object):
         self.search_path = os.environ["ANDROID_HOST_OUT"]
     self.signapk_shared_library_path = "lib64"   # Relative to search_path
     self.extra_signapk_args = []
+    # When use_pkcs11_aliases is True, SignFile() passes a PKCS#11 keystore
+    # alias (the CKA_LABEL on the token) to signapk.jar in place of the .pk8
+    # path. Used together with `-loadPrivateKeysFromKeyStore PKCS11` and
+    # `-providerArg <pkcs11.cfg>` in extra_signapk_args. The mapping from
+    # AOSP key basename (e.g. "releasekey") to CKA_LABEL is read from
+    # $OTATOOLS_PKCS11_ALIAS_MAP -- a comma-separated list of "name=label"
+    # entries. A missing entry falls back to the basename verbatim.
+    self.use_pkcs11_aliases = False
+    self.pkcs11_alias_map = {}
+    _pkcs11_raw = os.environ.get("OTATOOLS_PKCS11_ALIAS_MAP", "")
+    if _pkcs11_raw:
+      self.pkcs11_alias_map = {
+          k: v for k, v in (
+              p.split("=", 1) for p in _pkcs11_raw.split(",") if "=" in p)
+      }
     self.aapt2_path = "aapt2"
     self.java_path = "java"  # Use the one on the path by default.
     self.java_args = ["-Xmx4096m"]  # The default JVM args.
@@ -2407,6 +2422,11 @@ def GetKeyPasswords(keylist):
   # sorted() can't compare strings to None, so convert Nones to strings
   for k in sorted(keylist, key=lambda x: x if x is not None else ""):
     # We don't need a password for things that aren't really keys.
+    if OPTIONS.use_pkcs11_aliases:
+      # The private key lives on a PKCS#11 token; there is no .pk8 file to
+      # probe and no password to collect.
+      no_passwords.append(k)
+      continue
     if k in SPECIAL_CERT_STRINGS or k is None:
       no_passwords.append(k)
       continue
@@ -2571,7 +2591,7 @@ def SignFile(input_name, output_name, key, password, min_api_level=None,
     cmd.extend(["--min-sdk-version", str(min_sdk_version)])
 
   cmd.extend([key + OPTIONS.public_key_suffix,
-              key + OPTIONS.private_key_suffix,
+              _SignApkPrivateKeyArg(key),
               input_name, output_name])
 
   proc = Run(cmd, stdin=subprocess.PIPE)
@@ -2584,6 +2604,19 @@ def SignFile(input_name, output_name, key, password, min_api_level=None,
                                                        proc.returncode, stdoutdata))
 
 
+def _SignApkPrivateKeyArg(key):
+  """Returns the signapk.jar private-key argument for KEY.
+
+  In file mode, this is just <key>.pk8. In PKCS#11 mode, it's the CKA_LABEL
+  alias on the token, looked up from OPTIONS.pkcs11_alias_map by basename;
+  if no entry exists, the basename is used verbatim.
+  """
+  if not OPTIONS.use_pkcs11_aliases:
+    return key + OPTIONS.private_key_suffix
+  base = os.path.basename(key)
+  return OPTIONS.pkcs11_alias_map.get(base, base)
+
+
 def CheckSize(data, target, info_dict):
   """Checks the data string passed against the max size limit.
 
@@ -2768,7 +2801,8 @@ def ParseOptions(argv,
     opts, args = getopt.getopt(
         argv, "hvp:s:x:" + extra_opts,
         ["help", "verbose", "path=", "signapk_path=",
-         "signapk_shared_library_path=", "extra_signapk_args=", "aapt2_path=",
+         "signapk_shared_library_path=", "extra_signapk_args=",
+         "use_pkcs11_aliases", "aapt2_path=",
          "java_path=", "java_args=", "android_jar_path=", "public_key_suffix=",
          "private_key_suffix=", "boot_signer_path=", "boot_signer_args=",
          "verity_signer_path=", "verity_signer_args=", "device_specific=",
@@ -2792,6 +2826,8 @@ def ParseOptions(argv,
       OPTIONS.signapk_shared_library_path = a
     elif o in ("--extra_signapk_args",):
       OPTIONS.extra_signapk_args = shlex.split(a)
+    elif o == "--use_pkcs11_aliases":
+      OPTIONS.use_pkcs11_aliases = True
     elif o in ("--aapt2_path",):
       OPTIONS.aapt2_path = a
     elif o in ("--java_path",):
