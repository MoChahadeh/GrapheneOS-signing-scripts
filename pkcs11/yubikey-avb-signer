#!/bin/bash
#
# avbtool --signing_helper_with_files protocol.
#
# avbtool invokes this script as:
#     yubikey-avb-signer <algorithm> <public_key_path> <tmpfile>
#
# <tmpfile> contains the already PKCS#1 v1.5 padded hash (with the ASN.1
# DigestInfo header for the chosen hash algorithm). We must replace the file
# contents in-place with the raw RSA signature.
#
# Mapping from public_key_path -> token object is done in this order:
#   1. YUBIKEY_AVB_NAME      (AOSP key name, e.g. "avb") if set
#   2. basename(<pubkey>) with public-key suffixes stripped
#                            (avb_pubkey.pem -> "avb")
# The resolved name is then mapped to a PKCS#11 --id / --label argument via
# pkcs11_resolve_lookup (preferring YUBIKEY_ID_<name>).

set -o errexit -o nounset -o pipefail

# shellcheck source=pkcs11-lookup.sh
source "$(dirname "${BASH_SOURCE[0]}")/pkcs11-lookup.sh"

algorithm=$1
pubkey=$2
file=$3

case "$algorithm" in
    SHA256_RSA2048|SHA256_RSA4096|SHA256_RSA8192|\
    SHA512_RSA2048|SHA512_RSA4096|SHA512_RSA8192) ;;
    *)
        echo "yubikey-avb-signer: unsupported algorithm '$algorithm'" >&2
        exit 1
        ;;
esac

if [[ -n "${YUBIKEY_AVB_NAME:-}" ]]; then
    name="$YUBIKEY_AVB_NAME"
else
    name=$(basename "$pubkey")
    name=${name%.pem}
    name=${name%.x509}
    name=${name%_pubkey}
    name=${name%.pub}
fi

pkcs11_resolve_lookup "$name"

if [[ -z "${YUBIKEY_PKCS11_MODULE:-}" ]]; then
    echo "yubikey-avb-signer: YUBIKEY_PKCS11_MODULE is unset" >&2
    exit 1
fi
if [[ -z "${YUBIKEY_PIN:-}" ]]; then
    echo "yubikey-avb-signer: YUBIKEY_PIN is unset" >&2
    exit 1
fi

sig_tmpdir="${TMPDIR:-/tmp}"
[[ -d /dev/shm ]] && sig_tmpdir=/dev/shm
sig=$(mktemp "$sig_tmpdir/avbsig-XXXXXXXX")
trap 'rm -f "$sig"' EXIT

# CKM_RSA_X_509: raw RSA, no padding added by the token. The input is already
# fully padded by avbtool.
pkcs11-tool \
    --module "$YUBIKEY_PKCS11_MODULE" \
    ${YUBIKEY_PKCS11_SLOT:+--slot "$YUBIKEY_PKCS11_SLOT"} \
    --login --pin "$YUBIKEY_PIN" \
    --sign --mechanism RSA-X-509 \
    "${pkcs11_lookup_args[@]}" \
    --input-file "$file" \
    --output-file "$sig" \
    >/dev/null

# Replace the file contents atomically.
mv "$sig" "$file"
trap - EXIT
