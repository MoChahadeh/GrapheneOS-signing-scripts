#!/bin/bash
#
# avbtool --signing_helper_with_files protocol.
#
# avbtool invokes this script as:
#     yubikey-avb-signer <algorithm> <public_key_path> <tmpfile>
#
# <tmpfile> contains the already PKCS#1 v1.5 padded hash (with the ASN.1
# DigestInfo header for the chosen hash algorithm). We must replace the file
# contents in-place with the raw RSA signature.
#
# Mapping from public_key_path -> token label is done by checking the basename
# of the path against YUBIKEY_LABEL_<name> environment variables that the
# calling script exports (e.g. avb_pubkey.pem -> $YUBIKEY_LABEL_avb).

set -o errexit -o nounset -o pipefail

algorithm=$1
pubkey=$2
file=$3

case "$algorithm" in
    SHA256_RSA2048|SHA256_RSA4096|SHA256_RSA8192|\
    SHA512_RSA2048|SHA512_RSA4096|SHA512_RSA8192) ;;
    *)
        echo "yubikey-avb-signer: unsupported algorithm '$algorithm'" >&2
        exit 1
        ;;
esac

# Identify which PKCS#11 label to use. The caller is expected to either:
#   - set YUBIKEY_AVB_LABEL directly (used as a one-shot override), or
#   - export YUBIKEY_LABEL_<name> where <name> is the basename of <pubkey>
#     with public-key suffixes stripped (e.g. avb_pubkey.pem -> "avb").
if [[ -n "${YUBIKEY_AVB_LABEL:-}" ]]; then
    label="$YUBIKEY_AVB_LABEL"
else
    base=$(basename "$pubkey")
    base=${base%.pem}
    base=${base%.x509}
    base=${base%_pubkey}
    base=${base%.pub}
    var="YUBIKEY_LABEL_$base"
    label="${!var:-}"
    if [[ -z $label ]]; then
        echo "yubikey-avb-signer: no label configured for $pubkey" >&2
        echo "(set YUBIKEY_AVB_LABEL or YUBIKEY_LABEL_$base)" >&2
        exit 1
    fi
fi

if [[ -z "${YUBIKEY_PKCS11_MODULE:-}" ]]; then
    echo "yubikey-avb-signer: YUBIKEY_PKCS11_MODULE is unset" >&2
    exit 1
fi
if [[ -z "${YUBIKEY_PIN:-}" ]]; then
    echo "yubikey-avb-signer: YUBIKEY_PIN is unset" >&2
    exit 1
fi

sig=$(mktemp /dev/shm/avbsig-XXXXXXXX)
trap 'rm -f "$sig"' EXIT

# CKM_RSA_X_509: raw RSA, no padding added by the token. The input is already
# fully padded by avbtool.
pkcs11-tool \
    --module "$YUBIKEY_PKCS11_MODULE" \
    ${YUBIKEY_PKCS11_SLOT:+--slot "$YUBIKEY_PKCS11_SLOT"} \
    --login --pin "$YUBIKEY_PIN" \
    --sign --mechanism RSA-X-509 \
    --label "$label" \
    --input-file "$file" \
    --output-file "$sig" \
    >/dev/null

# Replace the file contents atomically.
mv "$sig" "$file"
trap - EXIT
