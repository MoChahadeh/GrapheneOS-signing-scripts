# YubiKey / PKCS#11 configuration for GrapheneOS signing.
#
# Copy this to pkcs11/yubikey.env (or any path of your choice) and source it
# before running the PKCS#11-aware signing scripts. yubikey.env is gitignored.
#
# All values are exported as environment variables; do not commit your edited
# copy.

# --- PKCS#11 module ---------------------------------------------------------
#
# Absolute path to the PKCS#11 module library that talks to your device.
#   YubiKey PIV:   /usr/lib/x86_64-linux-gnu/libykcs11.so  (Debian/Ubuntu)
#                  /usr/local/lib/libykcs11.so             (built from source)
#                  /usr/lib64/libykcs11.so                 (Fedora/RHEL)
#   YubiHSM 2:     /usr/lib/pkcs11/yubihsm_pkcs11.so
#   OpenSC:        /usr/lib/x86_64-linux-gnu/opensc-pkcs11.so
#
# YubiKey 5.7+ is required for RSA-4096 PIV. Older YubiKeys cap at RSA-2048.
export YUBIKEY_PKCS11_MODULE="/usr/lib/x86_64-linux-gnu/libykcs11.so"

# Slot ID in the PKCS#11 module (decimal). Most setups have one slot, leave
# unset to auto-pick the first slot with a present token. For YubiHSM with
# multiple keysets you may need to set this.
# export YUBIKEY_PKCS11_SLOT=0

# --- PIN --------------------------------------------------------------------
#
# PIV PIN for the YubiKey (or PKCS#11 user PIN). If unset, the signing
# scripts prompt once and re-use the value via the keep-alive cache.
#
# WARNING: putting a PIN in a file on disk defeats much of the benefit of a
# hardware token. Prefer interactive entry or a system credential store.
#
# export YUBIKEY_PIN="..."

# --- AOSP key name -> PKCS#11 alias / label ---------------------------------
#
# Map each AOSP signing key name (the basename used by the GrapheneOS scripts
# and AOSP signing tools) to the CKA_LABEL of the corresponding private key
# object on your token.
#
# `pkcs11-tool --module "$YUBIKEY_PKCS11_MODULE" --list-objects --type privkey`
# will print all available labels.
#
# YubiKey ykcs11 default labels (for reference -- adjust to match your setup):
#   slot 9a (PIV Authentication):    "Private key for PIV Authentication"
#   slot 9c (Digital Signature):     "Private key for Digital Signature"
#   slot 9d (Key Management):        "Private key for Key Management"
#   slot 9e (Card Authentication):   "Private key for Card Authentication"
#   slots 82-95 (Retired Key N):     "Private key for Retired Key N"
#
# These map to the 10 RSA-4096 keys GrapheneOS needs: 9 APK signing keys
# (declared in script/common.sh's signing_keys array) plus the AVB key.

export YUBIKEY_LABEL_releasekey="releasekey"
export YUBIKEY_LABEL_platform="platform"
export YUBIKEY_LABEL_shared="shared"
export YUBIKEY_LABEL_media="media"
export YUBIKEY_LABEL_networkstack="networkstack"
export YUBIKEY_LABEL_bluetooth="bluetooth"
export YUBIKEY_LABEL_sdk_sandbox="sdk_sandbox"
export YUBIKEY_LABEL_gmscompat_lib="gmscompat_lib"
export YUBIKEY_LABEL_nfc="nfc"
export YUBIKEY_LABEL_avb="avb"

# --- (Optional) factory-image signing key -----------------------------------
#
# GrapheneOS generate-release.sh signs factory-image zips with an ssh ed25519
# key if it finds one at keys/$DEVICE/id_ed25519. That key is unrelated to the
# RSA-4096 signing chain above and is not part of the YubiKey setup. You can
# keep it on disk encrypted or skip the factory-image signing step entirely.
