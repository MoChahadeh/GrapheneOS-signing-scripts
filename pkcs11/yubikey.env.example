# YubiKey / PKCS#11 configuration for GrapheneOS signing.
#
# Copy this to pkcs11/yubikey.env (or any path of your choice) and source it
# before running the PKCS#11-aware signing scripts. yubikey.env is gitignored.

# --- PKCS#11 module ---------------------------------------------------------
#
# Absolute path to the PKCS#11 module library that talks to your device.
#
#   OpenSC (recommended -- works for direct-attached *and* PC/SC-relayed
#                          YubiKeys, e.g. via pcsc-relay over the network):
#       /usr/lib/x86_64-linux-gnu/opensc-pkcs11.so   (Debian/Ubuntu)
#       /usr/lib64/opensc-pkcs11.so                  (Fedora/RHEL)
#       $(brew --prefix opensc)/lib/opensc-pkcs11.so (macOS)
#
#   Yubico's libykcs11 (direct-attached YubiKeys only -- it does NOT
#                       work through pcsc-relay or any PC/SC remoting):
#       /usr/lib/x86_64-linux-gnu/libykcs11.so       (Debian/Ubuntu)
#       /usr/local/lib/libykcs11.so                  (built from source)
#       /usr/lib64/libykcs11.so                      (Fedora/RHEL)
#
#   YubiHSM 2:
#       /usr/lib/pkcs11/yubihsm_pkcs11.so
#
# YubiKey 5.7+ is required for RSA-4096 PIV; older YubiKeys cap at RSA-2048.
export YUBIKEY_PKCS11_MODULE="/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so"

# Slot ID in the PKCS#11 module (decimal). Most setups have one slot; leave
# unset to auto-pick the first present token. With YubiHSM you may need it.
# export YUBIKEY_PKCS11_SLOT=0

# --- PIN --------------------------------------------------------------------
#
# PIV PIN for the YubiKey (or PKCS#11 user PIN). If unset, the signing
# scripts prompt once and re-use the value via the keep-alive cache.
#
# WARNING: putting a PIN in a file on disk defeats much of the benefit of a
# hardware token. Prefer interactive entry or a system credential store.
#
# export YUBIKEY_PIN="..."

# --- AOSP key name -> token object ------------------------------------------
#
# For each of the 10 RSA-4096 keys, set EITHER:
#
#   YUBIKEY_ID_<name>     hex CKA_ID of the slot (preferred)
#   YUBIKEY_LABEL_<name>  CKA_LABEL of the *certificate* on the token
#
# Both can be set; the helpers use ID if present, LABEL otherwise. LABEL is
# required for any key that goes through APK / OTA-package signing because
# signapk.jar's SunPKCS11 path only takes labels (the avb key never does, so
# it can be ID-only if you like).
#
# `pkcs11-tool --module "$YUBIKEY_PKCS11_MODULE" --list-objects` shows what
# the token reports.

# --- Why ID is more reliable than LABEL -------------------------------------
#
# CKA_ID is shared across cert / public key / private key for a single PIV
# slot, and never collides. CKA_LABEL is per-object, and different PKCS#11
# drivers label things differently. OpenSC's PIV driver, for instance,
# reports three distinct labels for one slot:
#
#   slot 9a  private key:  "PIV AUTH key"
#            public  key:  "PIV AUTH pubkey"
#            certificate:  "Certificate for PIV Authentication"
#
# pkcs11-tool's --label matches the *private key*'s label; signapk.jar's
# SunPKCS11 alias is the *certificate*'s label. Use ID for the helpers and
# the cert label for SunPKCS11 to keep them consistent.
#
# --- Example: YubiKey provisioned via OpenSC (default) ----------------------
# Active slots use IDs 1-4; retired slots map to IDs 5-9 then 0x10-0x17.
# OpenSC has a quirk where the retired-key IDs jump from 0x09 to 0x10 rather
# than 0x0A. Trust your token's actual output over the table.

export YUBIKEY_ID_releasekey="01"     # slot 9a
export YUBIKEY_ID_avb="02"            # slot 9c
export YUBIKEY_ID_platform="03"       # slot 9d
export YUBIKEY_ID_shared="05"         # slot 82
export YUBIKEY_ID_media="06"          # slot 83
export YUBIKEY_ID_networkstack="07"   # slot 84
export YUBIKEY_ID_bluetooth="08"      # slot 85
export YUBIKEY_ID_sdk_sandbox="09"    # slot 86
export YUBIKEY_ID_gmscompat_lib="10"  # slot 87 (0x10, not 0x0A!)
export YUBIKEY_ID_nfc="11"            # slot 88 (0x11)

export YUBIKEY_LABEL_releasekey="Certificate for PIV Authentication"
export YUBIKEY_LABEL_avb="Certificate for Digital Signature"
export YUBIKEY_LABEL_platform="Certificate for Key Management"
export YUBIKEY_LABEL_shared="Retired Certificate for Key Management 1"
export YUBIKEY_LABEL_media="Retired Certificate for Key Management 2"
export YUBIKEY_LABEL_networkstack="Retired Certificate for Key Management 3"
export YUBIKEY_LABEL_bluetooth="Retired Certificate for Key Management 4"
export YUBIKEY_LABEL_sdk_sandbox="Retired Certificate for Key Management 5"
export YUBIKEY_LABEL_gmscompat_lib="Retired Certificate for Key Management 6"
export YUBIKEY_LABEL_nfc="Retired Certificate for Key Management 7"

# --- Example: YubiKey via libykcs11 with custom CKA_LABELs ------------------
# If you're using Yubico's libykcs11 (direct-attached YubiKey, not relayed)
# and your provisioning set explicit labels matching the AOSP key names,
# LABEL-only is enough -- delete the OpenSC block above and uncomment this:

# export YUBIKEY_LABEL_releasekey="releasekey"
# export YUBIKEY_LABEL_platform="platform"
# export YUBIKEY_LABEL_shared="shared"
# export YUBIKEY_LABEL_media="media"
# export YUBIKEY_LABEL_networkstack="networkstack"
# export YUBIKEY_LABEL_bluetooth="bluetooth"
# export YUBIKEY_LABEL_sdk_sandbox="sdk_sandbox"
# export YUBIKEY_LABEL_gmscompat_lib="gmscompat_lib"
# export YUBIKEY_LABEL_nfc="nfc"
# export YUBIKEY_LABEL_avb="avb"

# --- (Optional) factory-image signing key -----------------------------------
#
# GrapheneOS generate-release.sh signs factory-image zips with an ssh ed25519
# key if it finds one at keys/$DEVICE/id_ed25519. That key is unrelated to
# the RSA-4096 signing chain above and isn't part of the YubiKey setup. You
# can keep it on disk encrypted or skip the factory-image signing step
# entirely.
